generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum ProductCondition {
  NEW
  PRE_OWNED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  LAPTOP
  KEYBOARD
  MOUSE
  MOUSE_PAD
  OTHER_ACCESSORY
}

enum LaptopUseCase {
  WORK
  STUDY
  GAMING
}

enum RamType {
  DDR4
  DDR5
  LPDDR4X
  LPDDR5
  LPDDR5X
  OTHER
}

enum StorageType {
  SSD
  HDD
  NVME
  SATA
  OTHER
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique @db.VarChar(254)
  passwordHash String          @db.VarChar(255)
  role         AdminRole       @default(ADMIN)
  status       AdminUserStatus @default(ACTIVE)
  lastLoginAt  DateTime?       @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  sessions     AdminSession[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([status, role])
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  csrfToken  String    @db.VarChar(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Product {
  id             String               @id @default(uuid()) @db.Uuid
  slug           String               @unique @db.VarChar(180)
  productType    ProductType          @default(LAPTOP)
  brand          String               @db.VarChar(80)
  model          String               @db.VarChar(160)
  description    String               @default("") @db.VarChar(10000)
  condition      ProductCondition
  conditionNotes String?              @db.VarChar(1000)
  useCase        LaptopUseCase?
  specs          Json                 @default("{}")
  status         ProductStatus        @default(DRAFT)
  currency       String               @default("EGP") @db.Char(3)
  priceMinor     Int
  cpu            String?              @db.VarChar(200)
  gpu            String?              @db.VarChar(200)
  baseRamGB      Int?
  baseRamType    RamType?
  baseStorageGB  Int?
  baseStorageType StorageType?
  displaySizeInches Float?
  displayResolution String?            @db.VarChar(80)
  displayPanel   String?               @db.VarChar(80)
  refreshRateHz  Int?
  stockQuantity  Int                   @default(0)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  ramOptions     ProductRamOption[]
  storageOptions ProductStorageOption[]
  combinations   ProductUpgradeCombination[]
  image          ProductImage?
  inventoryAdjustments InventoryAdjustment[]

  @@index([status, condition, createdAt])
  @@index([brand, model])
}

model ProductRamOption {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @db.Uuid
  capacityGB     Int
  type           RamType
  priceDeltaMinor Int     @default(0)
  isBase         Boolean  @default(false)
  isAvailable    Boolean  @default(true)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  combinations   ProductUpgradeCombination[] @relation("RamOptionCompatibility")

  @@unique([productId, capacityGB, type])
  @@index([productId, isAvailable])
}

model ProductStorageOption {
  id             String      @id @default(uuid()) @db.Uuid
  productId      String      @db.Uuid
  capacityGB     Int
  type           StorageType
  priceDeltaMinor Int        @default(0)
  isBase         Boolean     @default(false)
  isAvailable    Boolean     @default(true)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  combinations   ProductUpgradeCombination[] @relation("StorageOptionCompatibility")

  @@unique([productId, capacityGB, type])
  @@index([productId, isAvailable])
}

model ProductUpgradeCombination {
  productId        String      @db.Uuid
  ramCapacityGB    Int
  ramType          RamType
  storageCapacityGB Int
  storageType      StorageType
  isAvailable      Boolean     @default(true)
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ramOption        ProductRamOption @relation("RamOptionCompatibility", fields: [productId, ramCapacityGB, ramType], references: [productId, capacityGB, type], onDelete: Restrict, onUpdate: Cascade)
  storageOption    ProductStorageOption @relation("StorageOptionCompatibility", fields: [productId, storageCapacityGB, storageType], references: [productId, capacityGB, type], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, ramCapacityGB, ramType, storageCapacityGB, storageType])
  @@index([productId, isAvailable])
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String?  @unique @db.Uuid
  storageKey   String   @unique @db.VarChar(100)
  contentType  String   @db.VarChar(32)
  byteSize     Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([createdAt])
}

model InventoryAdjustment {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @db.Uuid
  adminUserId      String    @db.Uuid
  previousQuantity Int
  newQuantity      Int
  reason           String    @db.VarChar(500)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  product          Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId, createdAt])
  @@index([adminUserId, createdAt])
}
