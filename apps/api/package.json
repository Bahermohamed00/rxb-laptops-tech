{
  "name": "@rxb/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "npm run prisma:generate && nest start --watch",
    "build": "npm run prisma:generate && nest build",
    "start": "node .phase1-build/main.js",
    "typecheck": "npm run prisma:generate && tsc --project tsconfig.build.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "seed:samples": "npm run prisma:generate && npm run build && node .phase1-build/scripts/seed-sample-catalog.js",
    "admin:create": "npm run build && node .phase1-build/scripts/create-admin.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3"
  }
}
